APP_ENV=production
DATABASE_BACKEND=oracle
DEMO_MODE=false
DEMO_PASSWORD=
FLASK_SECRET_KEY=
PUBLIC_BASE_URL=https://library.your-approved-campus-domain.example
TRUSTED_HOSTS=library.your-approved-campus-domain.example,127.0.0.1
PROXY_HOPS=1
DB_USER=NIGHT_APP
DB_PASSWORD=
DB_DSN=tcps://your-oracle-host:2484/FREEPDB1
DB_SCHEMA=NIGHT_OWNER
DB_POOL_MAX=8
AUTH_MODE=oidc
OIDC_ISSUER=https://your-approved-identity-provider.example
OIDC_METADATA_URL=https://your-approved-identity-provider.example/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ATTENDANCE_PROVIDER=approved-campus-attendance
ATTENDANCE_WEBHOOK_SECRET=
ATTENDANCE_MAX_DELAY_SECONDS=3600

# For a DBA-approved Oracle wallet, mount it read-only and configure these locally.
DB_WALLET_PATH=
DB_WALLET_PASSWORD=
